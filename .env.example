# client.gerege.mn — Gerege Client.
#
# Жинхэнэ файл нь серверийн /opt/client-nexus/.env бөгөөд нууц утгуудтай тул
# энд хэзээ ч commit хийгдэхгүй (.gitignore). Энэ нь тэр файлын хэлбэр.
# deploy.sh нь үүнийг deploy/.env рүү хуулж, compose тэндээс уншина.

# --------------------------------------------------------------- энэ стек
# Портууд нь ЦӨМИЙН АНХДАГЧ БИШ (5439 / 8097 / 3017, бүгд зөвхөн loopback) —
# deploy/docker-compose.yml болон nginx/client.gerege.mn.conf дотор бичээстэй.
# Шалтгаан нь энэ стек nexus.gerege.mn-тэй ижил машин дээр сууж байгаа явдал.
CLIENT_NEXUS_POSTGRES_PASSWORD=

# Production дээр үүнгүйгээр сервер асахаас татгалзана (ValidateProduction).
# Энэ бол ЭНЭ суулгацын өөрийн built-in клиентийн нууц — nexus.gerege.mn дээрх
# бүртгэлийн нууц биш. Тэр нь доорх SSO_CLIENT_SECRET.
SSO_DEFAULT_CLIENT_SECRET=

# Цөмийн нийтэлсэн бүрхүүлийн образ. go.mod-ын цөмийн хувилбартай ижил
# commit дээр байлгана: backend v1.9.1 = 113a3e99. Хоёулаа хамт өөрчлөгдөнө.
WEB_IMAGE=ghcr.io/gerege-systems/open-gerege-nexus/frontend:113a3e9984a51434f28ad0d2258b82b248254cb4

# --------------------------------------------------------------------- домэйн
PUBLIC_ORIGIN=https://client.gerege.mn

# ------------------------------------------------- нэвтрэлт: nexus-ийн клиент
# Энэ суулгац хүнийг өөрөө таихаа болиод nexus.gerege.mn дээр таниулна.
# Провайдер дээр бүртгэгдсэн хоёр хаяг:
#   redirect_uris             https://client.gerege.mn/api/v1/auth/sso/callback
#   post_logout_redirect_uris https://client.gerege.mn/
# Эхнийхийг энд бичээгүй нь санаатай: анхдагч нь яг тэр утга
# (${SSO_ISSUER}/api/v1/auth/sso/callback, SSO_ISSUER нь PUBLIC_ORIGIN) тул
# гараар давтах нь буруу бичих хоёр дахь боломж.
SSO_CLIENT_ISSUER=https://nexus.gerege.mn
SSO_CLIENT_ID=client-gerege-nexus
# Confidential клиент: хоёр тал нь сервер тул PKCE дээр нэмээд нууцаар нотолно.
# Сан нь зөвхөн sha256 digest хадгалдаг — алдвал шинийг үүсгэх л гарц.
SSO_CLIENT_SECRET=
SSO_CLIENT_PROVIDER_NAME=Gerege Nexus
SSO_CLIENT_SCOPES=openid profile email
# Провайдерийн баталгаажуулсан ч энд бүртгэлгүй хүнийг энэ байгууллагад
# үүсгэнэ. Хоосон бол танихгүй хүнийг татгалзана.
SSO_CLIENT_TENANT=client
# false: орох цорын ганц зам нь nexus.gerege.mn. Провайдер унасан үед энэ
# мөрийг true болгоод backend-ээ дахин асаах нь буцах зам.
SSO_CLIENT_LOCAL_LOGIN=false

# ---------------------------------------------------------------------- брэнд
# Хүсэлт бүр дээр уншигдана — образ биш, тохиргоо.
BRAND_NAME=Gerege Client
BRAND_SHORT_NAME=Client
BRAND_DESCRIPTION=Nexus-ийн нэвтрэлтээр ажилладаг суулгац
BRAND_THEME_COLOR=#0050b0
# /opt/client-nexus/brand/ доторх файлууд, nginx-ээр /brand/… доор. Хоосон бол
# бүрхүүл образынхаа өөрийн зургийг үзүүлнэ.
BRAND_LOGO_URL=
BRAND_ICON_URL=
BRAND_MASKABLE_ICON_URL=

# ------------------------------------------------------------------ бусад
# «Өртөө» суваг. Хоосон бол унтраалттай — суулгац хэвийн асна.
# ХЭЗЭЭ Ч СОЛИХГҮЙ: суулгацын id үүнээс гардаг тул шинэ түлхүүр нь одоо байгаа
# бүх холбоосын токеныг хүчингүй болгоно.
URTUU_SIGNING_KEY=
